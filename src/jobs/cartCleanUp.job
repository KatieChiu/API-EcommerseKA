const cron = require('node-cron');
const prisma = require('../config/prisma');

const cleanExpiredCarts = async () => {
  try {
    console.log('🧹 Iniciando limpieza de carritos...');

    const deletedCarts = await prisma.cart.deleteMany({});

    console.log(
      `🧹 Limpieza completada: ${deletedCarts.count} carritos eliminados.`
    );
  } catch (error) {
    console.error('❌ Error limpiando carritos:', error);
  }
};

// Todos los días a las 10:00 PM
cron.schedule(
  '0 22 * * *',
  cleanExpiredCarts,
  {
    timezone: 'America/Tegucigalpa',
  }
);

console.log('⏰ Job de limpieza de carritos programado para las 10:00 PM.');
